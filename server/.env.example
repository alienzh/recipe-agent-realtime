AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGENT_GREETING=Hi! I'm a realtime voice assistant — let's just talk.

# Select the default realtime MLLM provider: openai or azure.
# The web selector overrides this value for each conversation.
# MLLM_VENDOR=openai

# OpenAI Realtime
OPENAI_API_KEY=your-openai-realtime-key
OPENAI_MODEL=gpt-4o-realtime-preview

# Azure OpenAI Realtime
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# AZURE_OPENAI_REALTIME_URL=wss://your-complete-azure-openai-realtime-url
# AZURE_OPENAI_REALTIME_MODEL=your-azure-deployment-or-model-name
