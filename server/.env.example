AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# REQUIRED — this recipe is NOT zero-key and needs OpenAI Realtime API access.
# Set this to your OpenAI API key with Realtime API access enabled.
OPENAI_API_KEY=your-openai-realtime-key

OPENAI_MODEL=gpt-4o-realtime-preview
